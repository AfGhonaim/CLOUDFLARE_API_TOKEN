# Cloudflare Pages deploy credentials. Copy to .env and fill in; .env is gitignored.
# Token needs the "Cloudflare Pages: Edit" permission and nothing more.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Facebook Page posting (scripts/facebook-post.mjs). See docs/FACEBOOK.md.
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=
# Only needed to discover the Page token with `node scripts/facebook-post.mjs pages`.
FB_USER_ACCESS_TOKEN=
# Optional: sends appsecret_proof with every call.
FB_APP_SECRET=
