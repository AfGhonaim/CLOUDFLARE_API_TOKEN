# Cloudflare Pages deploy credentials. Copy to .env and fill in; .env is gitignored.
# Token needs the "Cloudflare Pages: Edit" permission and nothing more.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Optional, only for scripts/render-scene.mjs. Separate token, with the
# "Workers AI: Read" permission, so the Pages token above stays Pages-only.
CLOUDFLARE_AI_TOKEN=
